{
  "name": "portfolio-projects-page",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-21",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "umitcagdas.com/projeler",
      "zone_name": "umitcagdas.com"
    },
    {
      "pattern": "umitcagdas.com/projeler/*",
      "zone_name": "umitcagdas.com"
    },
    {
      "pattern": "www.umitcagdas.com/projeler",
      "zone_name": "umitcagdas.com"
    },
    {
      "pattern": "www.umitcagdas.com/projeler/*",
      "zone_name": "umitcagdas.com"
    }
  ],
  "build": {
    "command": "node prepare-assets.mjs"
  },
  "assets": {
    "directory": ".public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": false
  }
}
