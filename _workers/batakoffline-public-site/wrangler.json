{
  "name": "batakoffline-public-site",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-21",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "batakoffline.umitcagdas.com",
      "custom_domain": true
    },
    {
      "pattern": "umitcagdas.com/batakoyunu",
      "zone_name": "umitcagdas.com"
    },
    {
      "pattern": "umitcagdas.com/batakoyunu/*",
      "zone_name": "umitcagdas.com"
    },
    {
      "pattern": "www.umitcagdas.com/batakoyunu",
      "zone_name": "umitcagdas.com"
    },
    {
      "pattern": "www.umitcagdas.com/batakoyunu/*",
      "zone_name": "umitcagdas.com"
    }
  ],
  "build": {
    "command": "node prepare-assets.mjs"
  },
  "assets": {
    "directory": ".public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
